/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-src https://challenges.cloudflare.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/README.md
  X-Robots-Tag: noindex

# Images rarely change: let browsers reuse them for 30 days.
# If you replace an image, give the new file a new name so visitors get it at once.
# HTML, CSS and JS keep Cloudflare's default (revalidate on every visit).
/images/*
  Cache-Control: public, max-age=2592000
